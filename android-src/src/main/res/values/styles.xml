<?xml version="1.0" encoding="utf-8"?>
<!-- 启动状态栏颜色与自定义启动图深度同步配置 -->
<resources>
    <style name="AppTheme" parent="@android:style/Theme.NoTitleBar">
        <item name="android:windowBackground">@drawable/presplash</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowIsTranslucent">false</item>

        <!-- 启动瞬间状态栏与导航栏立即呈现启动页背景色 #DFF3FF，浅色背景使用深色图标 -->
        <item name="android:statusBarColor">#DFF3FF</item>
        <item name="android:navigationBarColor">#DFF3FF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <!-- Android 12+ SplashScreen：与 presplash 背景严格统一 -->
        <item name="android:windowSplashScreenBackground">#DFF3FF</item>
        <item name="android:windowSplashScreenAnimatedIcon">@null</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@null</item>
        <item name="android:windowSplashScreenBrandingImage">@null</item>
        <item name="android:windowSplashScreenBehavior">icon_preferred</item>
    </style>

    <style name="PostSplashTheme" parent="@android:style/Theme.NoTitleBar">
        <item name="android:windowBackground">@drawable/presplash</item>
        <item name="android:statusBarColor">#DFF3FF</item>
        <item name="android:navigationBarColor">#DFF3FF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
